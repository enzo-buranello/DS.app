{
  "name": "ds-studio",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Concevoir un design system, des pages et des contenus, puis générer le code.",
  "main": "dist/main.js",
  "scripts": {
    "start": "node scripts/run.mjs start",
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/run.mjs build && playwright test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@fontsource-variable/geist": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.1.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
