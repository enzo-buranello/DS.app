# Copiez ce fichier en .env (ignoré par Git). Seules les clés FIGMA_* sont lues
# automatiquement ; les autres se définissent dans le terminal.
PORT=4310
# DS_STUDIO_DATA_DIR=chemin-vers-un-dossier-prive
# Aucun identifiant requis pour le mode manuel.

# Export Figma : app OAuth créée sur https://www.figma.com/developers/apps
# Redirect URL à déclarer : http://127.0.0.1:4310/api/figma/oauth/callback
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
